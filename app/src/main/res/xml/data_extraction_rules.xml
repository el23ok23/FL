<?xml version="1.0" encoding="utf-8"?>
<!-- La app no guarda datos del usuario: no hay nada que respaldar ni transferir. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
